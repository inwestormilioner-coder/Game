# Ninja Trading Group website configuration.
# Every "Enter Ninja Trading" button points here: a Telegram invite
# (https://t.me/...) or the future application URL. Leave empty until the
# destination is ready; the buttons then lead to the final invitation scene.
VITE_CTA_URL=

# Public origin of the deployed site, without a trailing slash
# (e.g. https://ninjatrading.group). Used for canonical and social-share URLs.
VITE_SITE_URL=
