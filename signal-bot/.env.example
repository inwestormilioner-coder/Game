# Token od @BotFather
BOT_TOKEN=123456:ABC...

# ID kanału/grupy z sygnałami (np. -1001234567890). Jeśli nie znasz — zostaw puste,
# uruchom bota, napisz coś na kanale i odczytaj ID z logów.
SOURCE_CHAT_ID=

# Gdzie wysyłać podsumowania (po przecinku). Domyślnie = SOURCE_CHAT_ID.
# Możesz dać swoje prywatne ID (sprawdzisz je komendą /start u bota).
REPORT_CHAT_IDS=

# Kto może używać komend /dzis, /tp itd. (Twoje ID użytkownika, po przecinku)
ADMIN_IDS=

TIMEZONE=Europe/Warsaw
# Godzina wysyłki raportów. Tygodniowy idzie w WEEKLY_DAY (6 = niedziela),
# miesięczny w ostatni dzień miesiąca — o tej samej godzinie.
REPORT_TIME=23:30
WEEKLY_DAY=6

# Strategie i ich nazwy w raporcie
STRATEGIES=1,2,3
STRATEGY_1_NAME=Strategia nr 1
STRATEGY_2_NAME=Strategia nr 2
STRATEGY_3_NAME=Strategia nr 3
# Własny regex rozpoznający strategię (pierwsza niepusta grupa = numer).
# Domyślnie łapie: "Strategia 1", "Strategia nr 2", "Strategy #3", "#S1", "#strat2"
# STRATEGY_REGEX=

# Czy odejmować pipsy ze stop lossów (false = liczymy tylko zdobyte pipsy z TP)
INCLUDE_SL_LOSSES=false
# Lista sygnałów w raporcie dziennym
DAILY_DETAILS=true
# Jeśli "TP2 ✅" przyjdzie jako zwykła wiadomość (nie odpowiedź) i bez symbolu,
# przypisz ją do ostatniego sygnału
FALLBACK_LAST_SIGNAL=true

# Nadpisanie wielkości pipsa, np. gdy na złocie 1 pips = 0.01
# PIP_SIZES=XAUUSD=0.1,US30=1

DB_PATH=signals.db
