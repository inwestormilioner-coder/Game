# ===== Strategia =====
# fibzone = odbicie od strefy + Fibo (BUY/SELL STOP 0.1272, SL -0.1272, TP na poziomach Fibo)
# smc     = BOS/CHOCH + retest strefy
STRATEGY=fibzone

# ===== Rynek =====
# Źródło danych: mt5 (ceny Twojego brokera, Windows + włączony terminal MT5)
#               | twelvedata (ogólne ceny spot, dowolny serwer) | csv (backtest)
DATA_SOURCE=mt5
# Symbol dokładnie jak w MT5 "Market Watch": RoboForex -> XAUUSD, Vantage -> XAUUSD lub XAUUSD+,
# Exness -> XAUUSDm. Twelve Data -> XAU/USD
SYMBOL=XAUUSD
# Minimalna odległość SL od wejścia w $ (odrzuca setupy z mikroskopijnym zakresem)
MIN_SL=3.0
DISPLAY_SYMBOL=XAUUSD
TIMEFRAME=M15
BARS=1500
MIN_RR=1.5
# Minimalna liczba konfluencji (Fibo 0.5-0.786, FVG, sweep płynności, Volume Profile): 0-4
MIN_SCORE=0
# TP: impulse (dołek/szczyt impulsu), liquidity (następna pula płynności) albo poc (POC profilu wolumenu)
TP_MODE=impulse

TWELVEDATA_API_KEY=

# MT5 (opcjonalnie; jeśli terminal jest już zalogowany, wystarczy puste)
MT5_LOGIN=
MT5_PASSWORD=
# Jeśli terminal MT5 jest już zalogowany, MT5_LOGIN / PASSWORD / SERVER mogą zostać puste.
# Przykłady serwerów: RoboForex-ECN, VantageInternational-Live (nazwa jak w oknie logowania MT5)
MT5_SERVER=
MT5_PATH=
# Czas serwera brokera względem UTC (np. 3). Puste = wykrywane automatycznie.
MT5_UTC_OFFSET=

# Backtest z pliku (eksport z MT5: time,open,high,low,close)
CSV_PATH=

# ===== AI (opis "dlaczego") =====
USE_AI=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
POST_LANGUAGE=pl

# ===== Publikacja =====
# Znak wodny na wykresie i link do grupy w postach na X / Threads
CHART_HANDLE=@TwojNick
# Podpis źródła danych na wykresie (np. RoboForex, Vantage)
CHART_SOURCE=RoboForex
# Obrazek do posta: render = własny wykres z poziomami | tradingview = sam zrzut Twojego layoutu TradingView
# (bez poziomów bota) | both = na Telegram oba zdjęcia w jednym poście (najpierw 4_LOGOWANIE_TRADINGVIEW.bat)
CHART_MODE=render
# Adres Twojego layoutu (otwórz wykres w TradingView i skopiuj adres z paska przeglądarki)
TV_CHART_URL=
# Symbol na TradingView, np. VANTAGE:XAUUSD, OANDA:XAUUSD
TV_SYMBOL=OANDA:XAUUSD
TV_PROFILE_DIR=tv_profile
TELEGRAM_INVITE_URL=https://t.me/TwojaGrupa
# Odpowiedź pod postem tylko po zaliczeniu 1:1 RR (i na zamknięciu z wynikiem >= +1R).
# true = odpisuje też przy stratach.
REPLY_LOSSES=false
# Wielkość pipsa do wyników pod sygnałem (złoto: 1 pips = 0.10$)
PIP_SIZE=0.1
# Cele Fibo (strategia fibzone), po przecinku. 0.382 = 1:1 RR; SL na wejście po TP1.
# Filtr kierunku EMA: BUY tylko nad EMA, SELL pod nią (i EMA rośnie/spada przez EMA_SLOPE świec). 0 = wyłączony.
# W teście M15 (6 mies.): mniej sygnałów (~1.7/dzień zamiast ~4), ten sam zysk w R, mniejsze obsunięcie.
EMA_FILTER=200
EMA_SLOPE=20
# Drugi typ sygnału: liquidity sweep (cena zbiera stopy za swingiem i wraca z długim knotem).
# Wejście STOP za świecą sweepu, SL za knotem, TP 1R i 2R. SWEEP_MIN_WICK = knot / korpus świecy.
SWEEP_SIGNALS=true
SWEEP_MIN_WICK=2.0
# AI ocenia każdy sweep przed wysłaniem i odrzuca słabe (wymaga ANTHROPIC_API_KEY, ok. kilka centów za ocenę)
SWEEP_AI_FILTER=false
# AI-menedżer pozycji (Claude, wymaga ANTHROPIC_API_KEY): od AI_MANAGER_MIN_R zysku albo po TP1 co świecę ocenia
# całą strukturę (M15 + H1, swingi, strefy, Volume Profile) i trzyma / przesuwa SL / realizuje część / zamyka.
AI_MANAGER=true
AI_MANAGER_MIN_R=0.5
# Wyjście AI bez klucza API (prosta reguła): zamknij na zysku (min. AI_EXIT_MIN_R x ryzyko), gdy świeca zamknie się za swingiem przeciw pozycji
AI_EXIT=true
AI_EXIT_MIN_R=0.5
# SL i TP strategii "strefa + Fibo":
#   atr = SL 2 x ATR od wejścia, cele 1R/2R/3R/4R/5R (w teście na MT5 M15 2025 i 2026: ok. 3x więcej R niż fib)
#   fib = SL na Fibo -0.1272, cele na poziomach TP_LEVELS
RISK_MODE=atr
SL_ATR=2.0
TP_R=1,2,3,4,5
TP_LEVELS=0.382,0.618,1.0,1.272,1.618

# ===== Bot formacji (double/triple top & bottom, głowa z ramionami, harmoniczne XABCD) =====
# true = działa obok strategii i publikuje na te same kanały. STRATEGY=patterns = tylko formacje.
PATTERNS_ENABLED=true
# all | chart (double/triple/H&S) | harmonic (Gartley, Bat, Alt Bat, Butterfly, Crab, Deep Crab, Cypher, Shark)
# albo lista: double_top,double_bottom,triple_top,triple_bottom,head_shoulders,inv_head_shoulders,gartley,bat,...
PATTERN_KINDS=all
# Skale ZigZaga w ATR (odwrócenie o tyle ATR potwierdza szczyt/dołek): 2 = mniejsze formacje, 4 = większe
PATTERN_DEPTHS=2,4
# Minimalna liczba konfluencji: strefa M15, strefa H1, Wasza strefa (ZONES_FILE), Fibo, Volume Profile, struktura H1
PATTERN_MIN_SCORE=2
# AI-analityk ogląda wykres i odrzuca słabe formacje (wymaga ANTHROPIC_API_KEY)
PATTERN_AI_FILTER=true
PATTERN_MIN_CONFIDENCE=60
# Wasze strefy (np. z D1/H4 albo ręcznie z TradingView) - patrz zones.example.json
ZONES_FILE=zones.json

# false = wysyła na włączone kanały (na start tylko Telegram); true = tylko wypisuje w konsoli.
DRY_RUN=false

TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
# ID grupy/kanału, np. -1001234567890 (bot musi być adminem)
TELEGRAM_CHAT_ID=

THREADS_ENABLED=false
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# Puste = wykres wgrywany automatycznie na catbox.moe (albo imgbb.com, jeśli podasz klucz z api.imgbb.com).
# Masz własny serwer? Wpisz publiczny adres katalogu data/, np. https://twojadomena.pl/signals
PUBLIC_IMAGE_BASE_URL=
IMGBB_API_KEY=

X_ENABLED=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

DATA_DIR=data

# --- Auto-trading na MT5 (np. Vantage demo) ---
# Każdy sygnał = 5 zleceń STOP (po jednym na TP), wspólny SL; po TP1 SL na wejście.
TRADE_ENABLED=false
# Ryzyko na cały sygnał w % salda (dzielone na 5 zleceń). Albo TRADE_LOT = stały lot na każde zlecenie.
TRADE_RISK_PCT=1.0
TRADE_LOT=0
# Symbol złota u brokera do handlu (Vantage: XAUUSD albo XAUUSD+). Puste = SYMBOL.
TRADE_SYMBOL=
# Osobny terminal do handlu, gdy dane idą z innego brokera (np. dane RoboForex, handel Vantage).
# Ścieżka do terminal64.exe Vantage, np. C:\Program Files\Vantage International MT5\terminal64.exe
TRADE_MT5_PATH=
TRADE_MT5_LOGIN=
TRADE_MT5_PASSWORD=
TRADE_MT5_SERVER=
# Bezpiecznik: bez tego bot odmówi handlu na koncie realnym.
TRADE_ALLOW_REAL=false
