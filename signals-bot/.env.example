# ===== Rynek =====
# Źródło danych: twelvedata (dowolny serwer, Linux) | mt5 (Windows + terminal MT5) | csv (backtest)
DATA_SOURCE=twelvedata
# Symbol u źródła: Twelve Data -> XAU/USD, MT5 Exness -> XAUUSDm
SYMBOL=XAU/USD
DISPLAY_SYMBOL=XAUUSD
TIMEFRAME=M30
BARS=500
MIN_RR=1.5
# Minimalna liczba konfluencji (Fibo 0.5-0.786, FVG, sweep płynności, Volume Profile): 0-4
MIN_SCORE=0
# TP: impulse (dołek/szczyt impulsu), liquidity (następna pula płynności) albo poc (POC profilu wolumenu)
TP_MODE=impulse

TWELVEDATA_API_KEY=

# MT5 (opcjonalnie; jeśli terminal jest już zalogowany, wystarczy puste)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Real
MT5_PATH=

# Backtest z pliku (eksport z MT5: time,open,high,low,close)
CSV_PATH=

# ===== AI (opis "dlaczego") =====
USE_AI=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
POST_LANGUAGE=pl

# ===== Publikacja =====
# true = nic nie wysyła, tylko wypisuje w konsoli. Zmień na false, gdy wszystko sprawdzisz.
DRY_RUN=true

TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
# ID grupy/kanału, np. -1001234567890 (bot musi być adminem)
TELEGRAM_CHAT_ID=

THREADS_ENABLED=false
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# Publiczny adres katalogu data/ (np. https://twojadomena.pl/signals) — Threads pobiera obrazek z URL
PUBLIC_IMAGE_BASE_URL=

X_ENABLED=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

DATA_DIR=data
