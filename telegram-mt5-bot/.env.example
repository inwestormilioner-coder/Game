# --- Telegram (user account, not a bot token) -----------------------------
# Get API_ID / API_HASH at https://my.telegram.org -> "API development tools"
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=signal_bot
# Channel/chat to listen to: @username, numeric id, or invite link
TELEGRAM_CHANNEL=

# --- MetaTrader 5 -----------------------------------------------------------
# Leave MT5_LOGIN/PASSWORD/SERVER empty to attach to an already logged-in
# terminal. Fill them in to have the bot log in itself.
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- Trading rules -----------------------------------------------------------
SYMBOL=XAUUSD
LOT_SIZE=0.01
ZONE_STEP=0.5
# Price value of 1 "pip" for your broker's gold quote. Many brokers quote
# XAUUSD with 2 decimals and call a 0.10 move "1 pip" (so 60 pips = $6).
# VERIFY THIS WITH YOUR BROKER before turning DRY_RUN off - getting it wrong
# puts your SL/TP at the wrong price.
PIP_SIZE=0.1
START_TP_PIPS=60
TP_INCREMENT_PIPS=10
DEVIATION_POINTS=20
MAGIC_BASE=990000

# --- Safety ------------------------------------------------------------------
# true  -> parse signals and log the orders that WOULD be sent, no MT5 calls.
# false -> actually send orders to MT5. Only flip this after you have
#          reviewed the DRY_RUN logs for a few real signals.
DRY_RUN=true
