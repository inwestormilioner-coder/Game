# --- Telegram (user account, not a bot token) -----------------------------
# Get API_ID / API_HASH at https://my.telegram.org -> "API development tools"
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=signal_bot
# Channel/chat to listen to: @username, numeric id, or invite link
TELEGRAM_CHANNEL=

# --- MetaTrader 5 -----------------------------------------------------------
# Leave MT5_LOGIN/PASSWORD/SERVER empty to attach to an already logged-in
# terminal. Fill them in to have the bot log in itself.
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Subfolder under MT5's shared Common\Files where the EA bridge command
# files go. Only change this if you're running a SECOND instance of this
# bot against a SECOND MT5 account on the same machine - MT5's Common
# folder is shared by every terminal install, so two instances using the
# same value here would cross-talk. Give the second instance its own value
# (e.g. tg_bridge_2) and set TelegramBridgeEA's BridgeSubfolder input to
# match on that account's chart.
MT5_BRIDGE_SUBFOLDER=tg_bridge

# --- Trading rules -----------------------------------------------------------
SYMBOL=XAUUSD
LOT_SIZE=0.01
# Lot size grows the closer an entry is to the shared SL: every
# LOT_TIER_ORDERS orders (counted from the entry furthest from SL), size
# increases by one more LOT_SIZE step - e.g. LOT_SIZE=0.01,
# LOT_TIER_ORDERS=3 across 10 orders gives
# 0.01,0.01,0.01,0.02,0.02,0.02,0.03,0.03,0.03,0.04
LOT_TIER_ORDERS=3
ZONE_STEP=0.5
# Price value of 1 "pip" for your broker's gold quote. Many brokers quote
# XAUUSD with 2 decimals and call a 0.10 move "1 pip" (so 60 pips = $6).
# VERIFY THIS WITH YOUR BROKER before turning DRY_RUN off - getting it wrong
# puts your SL/TP at the wrong price.
PIP_SIZE=0.1
# How TP is set for each order:
#   risk_reward (default) - TP is TP_RISK_REWARD_RATIO times THAT order's
#     own distance to the shared SL (1.0 = 1:1). Since SL is one fixed
#     price for the whole zone but every entry sits at a different
#     distance from it, TP grows automatically further from SL - no pip
#     numbers to pick by hand.
#   ladder - the old behaviour: START_TP_PIPS for the lowest price in the
#     zone, +TP_INCREMENT_PIPS pips per order above it (0 = same TP for
#     every order).
TP_MODE=risk_reward
TP_RISK_REWARD_RATIO=1.0
START_TP_PIPS=60
TP_INCREMENT_PIPS=10
DEVIATION_POINTS=20
MAGIC_BASE=990000

# --- Exit / own SL management (channel's "SL na BE"/"Zamykam calosc" ------
#      messages are always ignored - the bot manages exits itself) --------
# EXIT_MODE=tp (default): orders get a fixed TP (see TP_MODE above), and
#   once a zone's floating profit reaches RISK_REWARD_TRIGGER * initial
#   risk (1.0 = 1:1), the bot moves SL on every open position in that zone
#   to the basket's average entry price (one shared SL, not each
#   position's own entry) - a single, one-time move.
# EXIT_MODE=trailing_stop: orders get NO fixed TP at all. Instead every
#   open position's OWN SL continuously trails TRAILING_STOP_PIPS behind
#   price (tightening only, independently per position) until price
#   reverses that far and closes it. The RISK_REWARD_TRIGGER basket-average
#   move above does NOT apply in this mode (the two would fight each
#   other) - use this for a second bot instance/account run this way.
EXIT_MODE=tp
TRAILING_STOP_PIPS=36
RISK_REWARD_TRIGGER=1.0
MONITOR_INTERVAL_SECONDS=5

# --- Safety ------------------------------------------------------------------
# true  -> parse signals and log the orders that WOULD be sent, no MT5 calls.
# false -> actually send orders to MT5. Only flip this after you have
#          reviewed the DRY_RUN logs for a few real signals.
DRY_RUN=true

# A zone signal wider than this (in price, e.g. $20) is refused outright -
# no orders planned or placed - since real zones are usually $5-10 wide and
# anything much wider almost certainly means a parsing error, not a real
# signal (this happened once: a misparsed zone was ~$100 wide and would
# have fired ~200 orders instead of ~11).
MAX_ZONE_WIDTH=20.0
